ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
MODEL_PATH=./models/recommender.pkl
DATA_PATH=./data/recipes.csv
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Pluggable LLM Provider: 'gemini' (default), 'azure_openai', 'openai', 'mock'
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Microsoft Azure OpenAI Service (Optional)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-06-01

# Microsoft Azure AI Search (Optional Vector & Hybrid Database)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=mealmate-recipes

# OpenAI / Compatible Endpoints (vLLM, Ollama, Groq)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM Caching (TTL-LRU)
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=512
